<Window x:Class="Scalio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Scalio"
        Height="760" Width="1120"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A">

    <!--
        Pencere zemini koyu: WebView2 içeriği yüklenene kadar geçen kısa anda
        beyaz bir flaş görünmesin. Sayfanın kendi teması yüklendiğinde zaten
        üstünü örtüyor.
    -->
    <wv2:WebView2 x:Name="Browser" />
</Window>

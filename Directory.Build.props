<Project>

  <!--
    ⚠️ SÜRÜM TEK YERDE: Windows (Scalio.App) ve macOS/Linux (Scalio.Desktop)
    aynı numarayla çıkar. Sitedeki tek "son sürüm" değeri üç paketi birden
    tarif ediyor; iki ayrı numara bir sistemin her açılışta "güncelleme var"
    demesiyle sonuçlanırdı.
  -->
  <PropertyGroup>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <!--
    Tüm projeler için ortak yayın ayarları.

    ⚠️ Release'te hata ayıklama sembolü ÜRETİLMEZ. Aksi hâlde yayın klasöründe
    `.pdb` dosyaları kalıyor ve ürün "tek dosya" olmaktan çıkıyor — bu üründe
    tek dosya olmak ürünsel bir karar: kurtarılacak diske dosya yaymamak ve
    USB bellekten çalışabilmek.

    (Semboller gerekirse `-p:DebugType=portable` ile tek seferlik açılır.)
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
